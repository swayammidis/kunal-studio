# Where Get In Touch inquiries are delivered (any endpoint that accepts a JSON POST:
# Formspree, Make, Zapier, Google Apps Script, CRM webhook…). Without it the form
# falls back to a pre-filled email / WhatsApp message.
INQUIRY_WEBHOOK_URL=

# Optional Google Tag Manager container (GA4 + Google Ads conversions are configured inside GTM).
NEXT_PUBLIC_GTM_ID=
